  "protocol": {
    "header":"Idempotency-Key",
    "max_key_bytes":255,
    "ascii_range":[33,126],
    "digest":"SHA-256 of raw request body bytes; includes whitespace and run_metadata",
    "scope":"trimmed verified caller DID + NUL + trimmed target DID",
    "unique_key":["scope_key","request_key"],
    "conflict_on":["target","body_digest"],
    "http":{"invalid_key":400,"unauthenticated":401,"unavailable_store":503,"conflict":409,"replay":202,"queued":202},
    "replay_header":"X-AgentField-Idempotency-Replay",
    "replay_type":"empty string (Type is not populated but has no omitempty)",
    "replay_enqueued_at":"CreatedAt, not independently persisted queue time",
    "queue":"process-local channel; durable binding does not prove restart dispatch",
    "anchors":[
      {"source":"handler","text":"maxAsyncIdempotencyKeyLength = 255"},
      {"source":"handler","text":"character < 0x21 || character > 0x7e"},
      {"source":"handler","text":"digest := sha256.Sum256(body)"},
      {"source":"handler","text":"scopeKey:   callerDID + \"\\x00\" + targetDID"},
      {"source":"handler","text":"code: http.StatusUnauthorized"},
      {"source":"handler","text":"code: http.StatusServiceUnavailable"},
      {"source":"handler","text":"ctx.JSON(http.StatusConflict"},
      {"source":"handler","text":"ctx.Header(\"X-AgentField-Idempotency-Replay\", \"true\")"},
      {"source":"handler","text":"queue         chan asyncExecutionJob"},
      {"source":"storage","text":"ON CONFLICT (scope_key, request_key) DO NOTHING"},
      {"source":"storage","text":"storedTarget != target || storedDigest != bodyDigest"},
      {"source":"storage","text":"insertExecutionRecordTx(ctx, tx, execution)"},
      {"source":"storage","text":"if execution == nil"}
    ]
  },
